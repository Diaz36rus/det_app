# HTTPS via Let's Encrypt (Caddy automatic). Ports 80+443 must be open.
# www.det-app.ru не включаем — нет DNS A-записи (NXDOMAIN).
{
	email admin@det-app.ru
}

det-app.ru {
	handle_path /api/* {
		reverse_proxy api:8000
	}
	handle {
		root * /srv/website
		encode gzip
		try_files {path} /index.html
		file_server
	}
}

api.det-app.ru {
	reverse_proxy api:8000
}
